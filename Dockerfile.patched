# syntax=docker/dockerfile:1
FROM maven:3.9-eclipse-temurin-25 AS build
RUN git --version

ARG ARMERIA_REPOSITORY=https://github.com/cprayer/armeria.git
ARG ARMERIA_REF=7fa42d7b20cf89348c150b4c43825f331d6b3cc2
RUN git init /armeria \
    && git -C /armeria remote add origin "$ARMERIA_REPOSITORY" \
    && git -C /armeria fetch --depth=1 origin "$ARMERIA_REF" \
    && git -C /armeria checkout --detach FETCH_HEAD \
    && git -C /armeria rev-parse HEAD

COPY export-repro.gradle /app/export-repro.gradle
WORKDIR /armeria
RUN --mount=type=cache,target=/root/.gradle \
    ./gradlew --no-daemon --console=plain --info --max-workers=2 -PofflineJavadoc -PnoWeb \
    -I /app/export-repro.gradle copyReproJars

WORKDIR /app
ARG SPRING_BOOT_VERSION=3.5.16
RUN --mount=type=cache,target=/root/.m2 \
    mvn -B -ntp org.apache.maven.plugins:maven-dependency-plugin:3.8.1:copy \
    -Dartifact=org.springframework.boot:spring-boot-loader:${SPRING_BOOT_VERSION} \
    -DoutputDirectory=/app/boot-loader
COPY src /app/src
RUN mkdir -p /app/executable/BOOT-INF/classes /app/executable/BOOT-INF/lib \
    && cd /app/executable \
    && jar --extract --file /app/boot-loader/spring-boot-loader-${SPRING_BOOT_VERSION}.jar \
    && cp /armeria/build/repro-libs/*.jar BOOT-INF/lib/ \
    && javac --release 17 -cp 'BOOT-INF/lib/*' -d BOOT-INF/classes /app/src/main/java/repro/Main.java \
    && printf 'Manifest-Version: 1.0\nMain-Class: org.springframework.boot.loader.launch.JarLauncher\nStart-Class: repro.Main\nSpring-Boot-Version: %s\n\n' "$SPRING_BOOT_VERSION" > /app/manifest.mf \
    && jar --create --no-compress --file /app/repro.jar --manifest /app/manifest.mf -C /app/executable . \
    && git -C /armeria rev-parse HEAD > /app/armeria-commit.txt

FROM eclipse-temurin:25-jre
WORKDIR /app
COPY --from=build /app/repro.jar /app/repro.jar
COPY --from=build /app/armeria-commit.txt /app/armeria-commit.txt
USER 65532:65532
ENTRYPOINT ["java", "-jar", "/app/repro.jar"]
